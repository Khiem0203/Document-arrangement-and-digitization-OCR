CELERY_BROKER_URL="amqp://your_rabbitmq_user:your_rabbitmq_password@localhost:5672//"
CELERY_RESULT_BACKEND="db+postgresql://your_celery_db_user:your_celery_db_password@localhost:5432/celery_results"

POSTGRES_HOST="localhost"
POSTGRES_DB="your_ocr_db"
POSTGRES_USER="your_db_user"
POSTGRES_PW="your_db_password"

S3_ENDPOINT='http://localhost:9000/'
S3_ACCESS_KEY='your_s3_access_key'
S3_SECRET_KEY='your_s3_secret_key'
S3_REGION='us-east-1'
S3_SSL=False

LLM_MODEL="/path/to/models--5CD-AI--Vintern-1B-v3_5"
VISION_MODEL="5CD-AI/Vintern-1B-v3_5"
VISION_MODEL_SERVER="http://localhost:8005/v1/chat/completions"

DETECTRON_WEIGHTS="/path/to/OCR_CELERY/detectron_weights/main_model/model_final.pth"
DETECTRON_PHIEUTIN="/path/to/OCR_CELERY/detectron_weights/phieutin_model/model_final.pth"
DETECTRON2_API_URL="http://localhost:8003/detectron2/detect"
DETECTRON2_PHIEUTIN_API="http://localhost:8010/detectron2_phieutin/detect"

ENABLE_CAPITALIZATION_RULES="true"

ENABLE_SPELL_FIX="true"
